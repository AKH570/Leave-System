DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=app.abirhkhandokar.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.abirhkhandokar.com
# Optional path overrides; defaults are <application root>/staticfiles and media.
# DJANGO_STATIC_ROOT=/home/CPANEL_USERNAME/leave_management/staticfiles
# DJANGO_MEDIA_ROOT=/home/CPANEL_USERNAME/leave_management/media

DB_ENGINE=mysql
DB_NAME=CPANEL_USERNAME_leave_management
DB_USER=CPANEL_USERNAME_leave_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
TRUST_X_FORWARDED_PROTO=False
USE_X_FORWARDED_HOST=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

SESSION_TIMEOUT_SECONDS=600
DJANGO_LOG_LEVEL=INFO
# Optional; the parent directory must already exist and be writable.
# DJANGO_LOG_FILE=/home/CPANEL_USERNAME/logs/leave_management.log
